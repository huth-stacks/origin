{
  "name": "origin-contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "clarinet check",
    "format": "clarinet format",
    "format:check": "clarinet format --check",
    "test": "vitest run",
    "test:report": "vitest run -- --coverage --costs",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm format:check && pnpm check && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@stacks/clarinet-sdk": "3.23.1",
    "@stacks/transactions": "7.6.0",
    "@types/node": "24.4.0",
    "typescript": "7.0.2",
    "vitest": "4.0.7",
    "vitest-environment-clarinet": "3.0.2"
  },
  "packageManager": "pnpm@10.33.0"
}
