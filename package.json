{
  "name": "origin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "clarinet check",
    "demo:build": "vite build --config vite.demo.config.ts",
    "demo:dev": "vite --config vite.demo.config.ts",
    "demo:preview": "vite preview --config vite.demo.config.ts",
    "format": "clarinet format",
    "format:demo": "prettier --write \"demo/**/*.{ts,tsx,css,html}\" \"tests/demo-*.test.{ts,tsx}\" vite.demo.config.ts package.json tsconfig.json README.md demo-runbook.md leather-review-manifest.md",
    "format:demo:check": "prettier --check \"demo/**/*.{ts,tsx,css,html}\" \"tests/demo-*.test.{ts,tsx}\" vite.demo.config.ts package.json tsconfig.json README.md demo-runbook.md leather-review-manifest.md",
    "format:check": "clarinet format --check",
    "test": "vitest run",
    "test:report": "vitest run -- --coverage --costs",
    "testnet:accounts": "node scripts/create-testnet-accounts.ts",
    "testnet:fund-accounts": "node scripts/fund-testnet-accounts.ts",
    "testnet:issue-attestations": "node scripts/issue-testnet-attestations.ts",
    "testnet:verify": "node scripts/verify-testnet-deployment.ts",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm format:check && pnpm format:demo:check && pnpm check && pnpm typecheck && pnpm test && pnpm demo:build"
  },
  "devDependencies": {
    "@stacks/clarinet-sdk": "3.23.1",
    "@stacks/transactions": "7.6.0",
    "@stacks/wallet-sdk": "7.6.0",
    "@types/node": "24.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.0.7",
    "vitest-environment-clarinet": "3.0.2"
  },
  "packageManager": "pnpm@10.33.0"
}
